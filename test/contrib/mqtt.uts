+ Syntax check
= Import the MQTT layer
from scapy.contrib.mqtt import *


+ MQTT protocol test

= MQTTPublish, packet instantiation
p = MQTT()/MQTTPublish(topic='test1',value='test2')
assert p.type == 3
assert p.topic == b'test1'
assert p.value == b'test2'
assert p.len == None
assert p.length == None

= Fixed header and MQTTPublish, packet dissection
s = b'0\n\x00\x04testtest'
publish = MQTT(s)
assert publish.type == 3
assert publish.QOS == 0
assert publish.DUP == 0
assert publish.RETAIN == 0
assert publish.len == 10
assert publish[MQTTPublish].length == 4
assert publish[MQTTPublish].topic == b'test'
assert publish[MQTTPublish].value == b'test'

= MQTTPublish

topicC = "testtopic/command"

p1 = MQTT(
            QOS=1
        ) / MQTTPublish(
            topic=topicC,
            msgid=1234,
            value="msg1"
        )
p2 = MQTT(
            QOS=1
        ) / MQTTPublish(
            topic=topicC,
            msgid=1235,
            value="msg2"
        )

p = MQTT(raw(p1 / p2))
assert p[1].msgid == 1234

= MQTTConnect, packet instantiation
c = MQTT()/MQTTConnect(clientIdlen=5, clientId='newid')
assert c.type == 1
assert c.clientId == b'newid'
assert c.clientIdlen == 5

= MQTTConnect, packet dissection
s = b'\x10\x1f\x00\x06MQIsdp\x03\x02\x00<\x00\x11mosqpub/1440-kali'
connect = MQTT(s)
assert connect.length == 6
assert connect.protoname == b'MQIsdp'
assert connect.protolevel == 3
assert connect.usernameflag == 0
assert connect.passwordflag == 0
assert connect.willretainflag == 0
assert connect.willQOSflag == 0
assert connect.willflag == 0
assert connect.cleansess == 1
assert connect.reserved == 0
assert connect.klive == 60
assert connect.clientIdlen == 17
assert connect.clientId == b'mosqpub/1440-kali'

= MQTTDisconnect
mr = raw(MQTT()/MQTTDisconnect())                                                                                           
dc= MQTT(mr)                                                                                                                
assert dc.type == 14 

=MQTTConnack, packet instantiation
ck = MQTT()/MQTTConnack(sessPresentFlag=1,retcode=0)
assert ck.type == 2
assert ck.sessPresentFlag == 1
assert ck.retcode == 0

= MQTTConnack, packet dissection
s = b' \x02\x00\x00'
connack = MQTT(s)
assert connack.sessPresentFlag == 0
assert connack.retcode == 0


= MQTTSubscribe, packet instantiation
sb = MQTT()/MQTTSubscribe(msgid=1, topics=[MQTTTopicQOS(topic='newtopic', QOS=1, length=0)])
assert sb.type == 8
assert sb.msgid == 1
assert sb.topics[0].topic == b'newtopic'
assert sb.topics[0].length == 0
assert sb[MQTTSubscribe][MQTTTopicQOS].QOS == 1

= MQTTSubscribe, packet dissection
s = b'\x82\t\x00\x01\x00\x04test\x01'
subscribe = MQTT(s)
assert subscribe.msgid == 1
assert subscribe.topics[0].length == 4
assert subscribe.topics[0].topic == b'test'
assert subscribe.topics[0].QOS == 1


= MQTTSuback, packet instantiation
sk = MQTT()/MQTTSuback(msgid=1, retcodes=[0])
assert sk.type == 9
assert sk.msgid == 1
assert sk.retcodes == [0]

= MQTTSuback, packet dissection
s = b'\x90\x03\x00\x01\x00'
suback = MQTT(s)
assert suback.msgid == 1
assert suback.retcodes == [0]

s = b'\x90\x03\x00\x01\x00\x01'
suback = MQTT(s)
assert suback.msgid == 1
assert suback.retcodes == [0, 1]

= MQTTUnsubscribe, packet instantiation
unsb = MQTT()/MQTTUnsubscribe(msgid=1, topics=[MQTTTopic(topic='newtopic',length=0)])
assert unsb.type == 10
assert unsb.msgid == 1
assert unsb.topics[0].topic == b'newtopic'
assert unsb.topics[0].length == 0

= MQTTUnsubscribe, packet dissection
u = b'\xA2\x09\x00\x01\x00\x03\x61\x2F\x62'
unsubscribe = MQTT(u)
assert unsubscribe.msgid == 1
assert unsubscribe.topics[0].length == 3
assert unsubscribe.topics[0].topic == b'a/b'

= MQTTUnsuback, packet instantiation
unsk = MQTT()/MQTTUnsuback(msgid=1)
assert unsk.type == 11
assert unsk.msgid == 1

= MQTTUnsuback, packet dissection
u = b'\xb0\x02\x00\x01'
unsuback = MQTT(u)
assert unsuback.type == 11
assert unsuback.msgid == 1

= MQTTPubrec, packet instantiation
pc = MQTT()/MQTTPubrec(msgid=1)
assert pc.type == 5
assert pc.msgid == 1

= MQTTPubrec packet dissection
s = b'P\x02\x00\x01'
pubrec = MQTT(s)
assert pubrec.msgid == 1

= MQTTPublish, long value
p = MQTT()/MQTTPublish(topic='test1',value='a'*200)
assert bytes(p)
assert p.type == 3
assert p.topic == b'test1'
assert p.value == b'a'*200
assert p.len == None
assert p.length == None

= MQTT without payload
p = MQTT()
assert bytes(p) == b'\x10\x00'

= MQTT RandVariableFieldLen
assert type(MQTT().fieldtype['len'].randval()) == RandVariableFieldLen
assert type(MQTT().fieldtype['len'].randval() + 0) == int

= MQTTUnsubscribe
u = MQTT(b'\xA2\x0C\x00\x01\x00\x03\x61\x2F\x62\x00\x03\x63\x2F\x64')
assert MQTTUnsubscribe in u and len(u.topics) == 2 and u.topics[1].topic == b"c/d"

= MQTTSubscribe
u = MQTT(b'\x82\x10\x00\x01\x00\x03\x61\x2F\x62\x02\x00\x03\x63\x2F\x64\x00')
assert MQTTSubscribe in u and len(u.topics) == 2 and u.topics[1].topic == b"c/d"

= MQTTPublish without underlayer does not crash
p = MQTTPublish()
p.show()
assert p.topic == b""
assert p.value == b""
assert p.msgid is None


+ MQTT 5.0 variable byte integer

= VarIntField encoding and decoding
varint = VarIntField("x", 0)
for value, expected in [
    (0, b"\x00"),
    (127, b"\x7f"),
    (128, b"\x80\x01"),
    (16383, b"\xff\x7f"),
    (16384, b"\x80\x80\x01"),
    (2097151, b"\xff\xff\x7f"),
    (268435455, b"\xff\xff\xff\x7f"),
]:
    encoded = varint.addfield(None, b"", value)
    assert encoded == expected
    remain, decoded = varint.getfield(None, encoded + b"ZZ")
    assert decoded == value
    assert remain == b"ZZ"

= VarIntField rejects a malformed integer
try:
    VarIntField("x", 0).getfield(None, b"\x80\x80\x80\x80\x80")
except Scapy_Exception:
    pass
else:
    assert False


+ MQTT 5.0 length-prefixed fields

= MQTTStringField round trip
string_field = MQTTStringField("s", b"")
encoded = string_field.addfield(None, b"", b"hello")
assert encoded == b"\x00\x05hello"
remain, decoded = string_field.getfield(None, encoded + b"tail")
assert decoded == b"hello"
assert remain == b"tail"

= MQTTBinaryField round trip
binary_field = MQTTBinaryField("b", b"")
encoded = binary_field.addfield(None, b"", b"\x00\x01\xfe")
assert encoded == b"\x00\x03\x00\x01\xfe"
remain, decoded = binary_field.getfield(None, encoded)
assert decoded == b"\x00\x01\xfe"
assert remain == b""

= MQTTStringPairField round trip
pair_field = MQTTStringPairField("p", (b"", b""))
encoded = pair_field.addfield(None, b"", (b"name", b"value"))
assert encoded == b"\x00\x04name\x00\x05value"
remain, decoded = pair_field.getfield(None, encoded)
assert decoded == (b"name", b"value")
assert remain == b""


+ MQTT 5.0 properties

= MQTTProperty value kind selection
assert isinstance(
    mqtt_property_value_field(MQTT_PROP_PAYLOAD_FORMAT_INDICATOR),
    ByteField
)
assert isinstance(
    mqtt_property_value_field(MQTT_PROP_RECEIVE_MAXIMUM),
    ShortField
)
assert isinstance(
    mqtt_property_value_field(MQTT_PROP_SESSION_EXPIRY_INTERVAL),
    IntField
)
assert isinstance(
    mqtt_property_value_field(MQTT_PROP_MAXIMUM_PACKET_SIZE),
    LongField
)
assert isinstance(
    mqtt_property_value_field(MQTT_PROP_SUBSCRIPTION_IDENTIFIER),
    VarIntField
)
assert isinstance(
    mqtt_property_value_field(MQTT_PROP_CORRELATION_DATA),
    MQTTBinaryField
)
assert isinstance(
    mqtt_property_value_field(MQTT_PROP_USER_PROPERTY),
    MQTTStringPairField
)

= MQTTProperty build and dissect
prop = MQTTProperty(prop=MQTT_PROP_RECEIVE_MAXIMUM, value=10)
assert raw(prop) == b"\x21\x00\x0a"
decoded = MQTTProperty(raw(prop))
assert decoded.prop == MQTT_PROP_RECEIVE_MAXIMUM
assert decoded.value == 10

= MQTTPropertiesField build and dissect
properties = [
    MQTTProperty(prop=MQTT_PROP_SESSION_EXPIRY_INTERVAL, value=3600),
    MQTTProperty(prop=MQTT_PROP_RECEIVE_MAXIMUM, value=10),
    MQTTProperty(prop=MQTT_PROP_USER_PROPERTY,
                 value=(b"role", b"sensor")),
]
field = MQTTPropertiesField("properties", [])
encoded = field.addfield(None, b"", properties)
remain, decoded = field.getfield(None, encoded)
assert remain == b""
assert [prop.prop for prop in decoded] == [
    MQTT_PROP_SESSION_EXPIRY_INTERVAL,
    MQTT_PROP_RECEIVE_MAXIMUM,
    MQTT_PROP_USER_PROPERTY,
]
assert decoded[0].value == 3600
assert decoded[1].value == 10
assert decoded[2].value == (b"role", b"sensor")
assert field.addfield(None, b"", decoded) == encoded

= MQTTPropertiesField rejects truncated data
try:
    MQTTPropertiesField("p", []).getfield(None, b"\x05\x11\x00")
except Scapy_Exception:
    pass
else:
    assert False


+ MQTT 5.0 CONNECT

= MQTTConnect 5.0 build and dissect with properties
connect = MQTT() / MQTTConnect(
    protoname="MQTT",
    protolevel=5,
    cleansess=1,
    klive=60,
    clientId="scapy",
    properties=[
        MQTTProperty(prop=MQTT_PROP_SESSION_EXPIRY_INTERVAL, value=3600),
        MQTTProperty(prop=MQTT_PROP_RECEIVE_MAXIMUM, value=10),
        MQTTProperty(prop=MQTT_PROP_USER_PROPERTY,
                     value=(b"role", b"sensor")),
    ],
)
decoded = MQTT(raw(connect))
assert decoded.protolevel == 5
assert decoded.clientId == b"scapy"
assert len(decoded.properties) == 3
assert decoded.properties[0].prop == MQTT_PROP_SESSION_EXPIRY_INTERVAL
assert decoded.properties[0].value == 3600
assert decoded.properties[1].value == 10
assert decoded.properties[2].value == (b"role", b"sensor")
assert raw(decoded) == raw(connect)

= MQTTConnect 5.0 with empty properties
connect = MQTT() / MQTTConnect(
    protoname="MQTT", protolevel=5, clientId="",
)
decoded = MQTT(raw(connect))
assert decoded.properties == []
assert raw(decoded) == raw(connect)

= MQTTConnect 5.0 with will properties and credentials
connect = MQTT() / MQTTConnect(
    protoname="MQTT",
    protolevel=5,
    willflag=1,
    willQOSflag=1,
    cleansess=1,
    clientId="scapy",
    properties=[
        MQTTProperty(prop=MQTT_PROP_SESSION_EXPIRY_INTERVAL, value=60),
    ],
    willproperties=[
        MQTTProperty(prop=MQTT_PROP_WILL_DELAY_INTERVAL, value=5),
    ],
    willtopic="last/will",
    willmsg=b"bye",
    usernameflag=1,
    username="user",
    passwordflag=1,
    password=b"secret",
)
decoded = MQTT(raw(connect))
assert decoded.willproperties[0].prop == MQTT_PROP_WILL_DELAY_INTERVAL
assert decoded.willproperties[0].value == 5
assert decoded.willtopic == b"last/will"
assert decoded.willmsg == b"bye"
assert decoded.username == b"user"
assert decoded.password == b"secret"
assert raw(decoded) == raw(connect)


+ MQTT 5.0 CONNACK

= MQTTConnack 5.0 build and dissect with properties
connack = MQTT() / MQTTConnack(
    sessPresentFlag=0,
    retcode=0,
    properties=[
        MQTTProperty(prop=MQTT_PROP_RECEIVE_MAXIMUM, value=20),
        MQTTProperty(prop=MQTT_PROP_ASSIGNED_CLIENT_IDENTIFIER,
                     value=b"scapy"),
    ],
)
decoded = MQTT(raw(connack))
assert decoded.retcode == 0
assert decoded.properties[0].prop == MQTT_PROP_RECEIVE_MAXIMUM
assert decoded.properties[0].value == 20
assert decoded.properties[1].value == b"scapy"
assert raw(decoded) == raw(connack)

= MQTTConnack 5.0 with empty properties
decoded = MQTT(b" \x03\x00\x00\x00")
assert decoded.retcode == 0
assert decoded.properties == []
assert raw(decoded) == b" \x03\x00\x00\x00"


+ MQTT 5.0 PUBLISH

= MQTTPublish 5.0 QoS 0 build and dissect with properties
stream = (
    MQTT() / MQTTConnect(protolevel=5, clientId="")
    / MQTT(QOS=0) / MQTTPublish(
        topic="sensors/temp",
        value=b'{"temp":21.5}',
        properties=[
            MQTTProperty(prop=MQTT_PROP_CONTENT_TYPE,
                         value=b"application/json"),
            MQTTProperty(prop=MQTT_PROP_USER_PROPERTY,
                         value=(b"unit", b"celsius")),
        ],
    )
)
decoded = MQTT(raw(stream))
publish = decoded[MQTTPublish]
assert publish.topic == b"sensors/temp"
assert publish.value == b'{"temp":21.5}'
assert publish.properties[0].prop == MQTT_PROP_CONTENT_TYPE
assert publish.properties[0].value == b"application/json"
assert publish.properties[1].value == (b"unit", b"celsius")
assert raw(decoded) == raw(stream)

= MQTTPublish 5.0 QoS 1 build and dissect with message identifier
stream = (
    MQTT() / MQTTConnect(protolevel=5, clientId="")
    / MQTT(QOS=1) / MQTTPublish(
        topic="t",
        msgid=7,
        value=b"pay",
        properties=[
            MQTTProperty(prop=MQTT_PROP_MESSAGE_EXPIRY_INTERVAL, value=30),
        ],
    )
)
decoded = MQTT(raw(stream))
publish = decoded[MQTTPublish]
assert publish.msgid == 7
assert publish.value == b"pay"
assert publish.properties[0].value == 30
assert raw(decoded) == raw(stream)

= MQTTPublish 5.0 with binary and variable byte integer properties
stream = (
    MQTT() / MQTTConnect(protolevel=5, clientId="")
    / MQTT() / MQTTPublish(
        topic="t",
        value=b"v",
        properties=[
            MQTTProperty(prop=MQTT_PROP_CORRELATION_DATA,
                         value=b"\x00\x01\xfe"),
            MQTTProperty(prop=MQTT_PROP_SUBSCRIPTION_IDENTIFIER,
                         value=300),
        ],
    )
)
decoded = MQTT(raw(stream))
publish = decoded[MQTTPublish]
assert publish.properties[0].value == b"\x00\x01\xfe"
assert publish.properties[1].value == 300
assert raw(decoded) == raw(stream)


+ MQTT 3.1.1 compatibility

= MQTTConnect 3.1.1 has no properties field
connect = MQTT(b"\x10\x1f\x00\x06MQIsdp\x03\x02\x00<"
               b"\x00\x11mosqpub/1440-kali")
assert connect.protolevel == 3
assert connect.clientId == b"mosqpub/1440-kali"
assert "properties" not in connect.fields

= MQTTConnect 3.1.1 build stays unchanged
connect = MQTT() / MQTTConnect(
    protoname="MQTT", protolevel=4, cleansess=1, klive=60,
    clientId="scapy-legacy",
)
decoded = MQTT(raw(connect))
assert decoded.protolevel == 4
assert "properties" not in decoded.fields
assert raw(decoded) == raw(connect)

= MQTTConnack 3.1.1 stays a two byte packet
connack = MQTT(b" \x02\x00\x00")
assert type(connack.payload) is MQTTConnack
assert connack.retcode == 0
assert "properties" not in connack[MQTTConnack].fields
assert raw(connack) == b" \x02\x00\x00"

= MQTTPublish 3.1.1 stays unchanged
publish = MQTT(b"0\n\x00\x04testtest")
assert publish.topic == b"test"
assert publish.value == b"test"
assert "properties" not in publish[MQTTPublish].fields
assert raw(publish) == b"0\n\x00\x04testtest"


+ MQTT 5.0 pcap regression

= Dissect MQTT 5.0 and 3.1.1 packets from a pcap
pcap = rdpcap(scapy_path("/test/pcaps/mqtt5.pcap.gz"))
assert len(pcap) == 6
connect = pcap[0][MQTTConnect]
assert connect.protolevel == 5
assert connect.properties[0].prop == MQTT_PROP_SESSION_EXPIRY_INTERVAL
assert connect.properties[0].value == 3600
assert connect.properties[3].value == (b"role", b"sensor")
connack = pcap[1][MQTTConnack]
assert connack.properties[0].value == 20
assert connack.properties[1].value == b"scapy"
stream = pcap[2]
publish = stream[MQTTPublish]
assert publish.topic == b"sensors/temp"
assert publish.value == b'{"temp":21.5}'
assert publish.properties[0].value == b"application/json"
legacy_connect = pcap[3][MQTTConnect]
assert legacy_connect.protolevel == 4
assert "properties" not in legacy_connect.fields
legacy_publish = pcap[5][MQTTPublish]
assert legacy_publish.topic == b"legacy/topic"
assert legacy_publish.value == b"hello"
assert "properties" not in legacy_publish.fields
